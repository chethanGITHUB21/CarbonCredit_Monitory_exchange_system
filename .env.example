# =============================================================================
#  .env  —  Environment Variables
#  Copy to node_gateway/.env  AND  fastapi_engine/.env
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:1chethan@PostgreSql@localhost:5432/carbon_db

# ── FastAPI async DSN (asyncpg) ───────────────────────────────
# (Used in fastapi_engine if you add SQLAlchemy async DB)
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:1chethan@PostgreSql@localhost:5432/carbon_db

# ── Node.js → FastAPI bridge ──────────────────────────────────
FASTAPI_URL=http://localhost:8000

# ── JWT secrets (change to strong random strings in production) ─
JWT_SECRET=2026b1abf4aaa8872094e2a6a51a01e748da61f6c1795194d71dff3781cc47a6
JWT_REFRESH_SECRET=2026b1abf4aaa8872094e2a6a51a01e748da61f6c1795194d71dff3781cc47a6

# ── Node.js ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001
